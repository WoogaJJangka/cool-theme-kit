{
  "name": "cool-theme-kit",
  "displayName": "Cool Theme Kit (JetBrains Look)",
  "description": "JetBrains (PyCharm New UI) style theme for VS Code: file icons, colors and product icons, with other installed themes layered on top by priority",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/WoogaJJangka/cool-theme-kit.git"
  },
  "author": {
    "name": "siwon Jeon",
    "url": "https://github.com/WoogaJJangka"
  },
  "license": "MIT",
  "main": "./dist/extension",
  "icon": "logo.png",
  "homepage": "https://github.com/WoogaJJangka/cool-theme-kit/blob/main/README.md",
  "scripts": {
    "build": "bun run compile:dev && bun run postcompile",
    "sync:upstream": "ts-node ./src/scripts/icons/syncUpstream.ts",
    "sync:metrics": "ts-node ./src/scripts/icons/syncIconMetrics.ts",
    "sheet:icons": "ts-node ./src/scripts/icons/iconSheets.ts",
    "compile": "node esbuild.js --production",
    "compile-web": "webpack --config ./build/web-extension.webpack.config.js",
    "compile:dev": "webpack --config ./build/webpack.config.js --mode none",
    "compile:watch": "webpack --config ./build/webpack.config.js --mode none --watch",
    "generateJson": "ts-node ./src/scripts/icons/generateJson.ts",
    "lint": "eslint \"./src/**/*.ts\"",
    "package-web": "webpack --mode production --devtool hidden-source-map --config ./build/web-extension.webpack.config.js",
    "postcompile": "bun run generateJson",
    "pretest": "bun run build && tsc -p ./",
    "test:smoke": "node ./test/smoke/run.js",
    "screenshots": "node ./test/screenshots/capture.js",
    "test:unit": "node ./test/run-unit.js",
    "test:coverage": "c8 node ./test/run-unit.js",
    "audit:shipped": "bun ./test/checks/auditShipped.js",
    "check:size": "node ./test/checks/sizeBudget.js",
    "check:notices": "node ./test/checks/notices.js",
    "sync:notices": "node ./test/checks/notices.js --write",
    "webfont": "ts-node ./src/scripts/icons/webfont.ts",
    "vscode:prepublish": "bun run lint && bun run compile && bun run package-web",
    "watch-web": "webpack --watch --config ./build/web-extension.webpack.config.js",
    "sync:colors": "ts-node ./src/scripts/themes/syncJetbrainsColors.ts",
    "check:colors": "ts-node ./src/scripts/themes/checkColors.ts",
    "check:semantic": "ts-node ./src/scripts/themes/checkSemantic.ts",
    "compare:ide": "ts-node ./src/scripts/themes/compareIde.ts",
    "build:product-icons": "ts-node ./src/scripts/productIcons/buildJetbrainsFont.ts",
    "build:logo": "ts-node ./src/scripts/buildLogo.ts",
    "analyze:presets": "ts-node ./src/scripts/presets/analyzePresets.ts"
  },
  "dependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fs-extra": "^11.4.1",
    "globals": "^15.15.0",
    "jsonc-eslint-parser": "^2.4.2",
    "lodash.merge": "4.6.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.4.1",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/lodash.merge": "^4.6.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vscode/test-electron": "^2.5.2",
    "c8": "^10.1.3",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsonc": "^2.21.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-unicorn": "^56.0.1",
    "fast-xml-parser": "4.5.7",
    "glob": "^11.1.0",
    "i18next": "^24.2.3",
    "mocha": "^12.0.3",
    "oslllo-potrace": "3.0.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "svgo": "^3.3.5",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2",
    "webfont": "^11.2.26",
    "webpack": "^5.113.0",
    "webpack-cli": "^5.1.4"
  },
  "badges": [],
  "browser": "./dist/web/extension.js",
  "bugs": {
    "url": "https://github.com/WoogaJJangka/cool-theme-kit/issues"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "description": "%capabilities.untrustedWorkspaces%",
      "restrictedConfigurations": [
        "a-file-icon-vscode.filesAssociations",
        "a-file-icon-vscode.foldersAssociations",
        "a-file-icon-vscode.languagesAssociations"
      ],
      "supported": "limited"
    },
    "virtualWorkspaces": true
  },
  "categories": [
    "Themes"
  ],
